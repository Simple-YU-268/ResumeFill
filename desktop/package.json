{
  "name": "resumefill-desktop",
  "version": "0.22.0",
  "description": "ResumeFill dedicated application agent",
  "author": "ResumeFill",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:resources": "node prepare.cjs",
    "dist": "npm run prepare:resources && electron-builder --win nsis --x64",
    "test": "node test.cjs && node pairing-test.cjs && node model-test.cjs && node updater-test.cjs && node updater-renderer-test.cjs"
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.resumefill.agent",
    "productName": "ResumeFill Agent",
    "publish": [
      {
        "provider": "github",
        "owner": "Simple-YU-268",
        "repo": "ResumeFill",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "../dist/desktop"
    },
    "files": [
      "main.cjs",
      "updater.cjs",
      "preload.cjs",
      "controller.cjs",
      "pairing.cjs",
      "ui/**/*",
      "pdf-service.cjs",
      "pdf-worker.cjs",
      "web-ocr.cjs",
      "web-ocr-worker.cjs"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "agent"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ResumeFill-Agent-${version}-Setup.${ext}"
    },
    "asarUnpack": [
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.80",
    "electron-updater": "6.6.2",
    "pdf-parse": "2.4.5",
    "tesseract.js": "7.0.0"
  },
  "license": "MIT"
}
