{
  "manifest_version": 3,
  "name": "简历快填 · ResumeFill",
  "version": "0.17.0",
  "description": "专用填表 Agent：观察、规划、工具执行、独立回读和人工继续",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "简历快填"
  },
  "options_page": "options.html"
}
